select 
mp.id as map_id,
mp.title as map_title,
COALESCE(ing_data.ingredients, '[]'::json) AS ingredients,
COALESCE(tile_data.tiles, '[]'::json) AS tiles
from dev.maps as mp
LEFT JOIN LATERAL (
    SELECT JSON_AGG(
        JSON_BUILD_OBJECT(
            'step_idx', mli.step_idx,
            'label', ing.lable,
            'image_src', imgdx_ing.src,
            'weight', mli.weight,
            'unit', mli.unit
        ) ORDER BY mli.step_idx
    ) AS ingredients
    FROM dev.map_list_ingridians AS mli
    LEFT JOIN dev.ingridiants AS ing ON ing.id = mli.ingridiant_id 
    LEFT JOIN dev.img_index AS imgdx_ing ON imgdx_ing.idx = ing.img_src_id
    WHERE mli.map_id = mp.id
) ing_data ON true
LEFT JOIN LATERAL (
    SELECT JSON_AGG(
        JSON_BUILD_OBJECT(
            'step_idx', mt.step_idx,
            'type_tile', mt.type_tile,
            'image_src', imgdx_tile.src,
            'modal_info', mt.modal_info 
        ) ORDER BY mt.step_idx
    ) AS tiles
    FROM dev.maps_tiles AS mt
    LEFT JOIN dev.img_index AS imgdx_tile ON imgdx_tile.idx = mt.src_img_id
    WHERE mt.map_id = mp.id
) tile_data ON TRUE;
GROUP BY mp.id;



